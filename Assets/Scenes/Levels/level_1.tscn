[sub_resource type="GDScript" id="GDScript_6s2ob"]
resource_local_to_scene = true
script/source = "extends Area2D

@export var fade_in_time = 1.0
@export var fade_in_time_loop = 0.5
@export var tutorial_text : Label
@export var tween_ease : Tween.EaseType
@export var transition : Tween.TransitionType

func _on_body_entered(body: Node2D) -> void:
	if body is PlayerController:
		tutorial_text.text = \"Press [Space] to jump\"
		if GameManager.deaths > 0:
			tutorial_text.text = \"Or Maybe it was... [Tab]?\"
		if Input.is_action_pressed(\"Tab\"):
			tutorial_text.text = \"Haha! Tricked you\"
		if GameManager.deaths > 1:
			tutorial_text.text = \"Ah right! It was [Ctrl + Alt] / [Alt Gr]\"

func move_tween():
	var tween = get_tree().create_tween()
	tween.set_loops(1)
	tween.tween_property(tutorial_text, \"modulate:a\", 1.0, fade_in_time).from(0.0)
	tween.tween_await(body_exited)
	tween.tween_property(tutorial_text, \"modulate:a\", 0.0, fade_in_time).from(1.0)
"

